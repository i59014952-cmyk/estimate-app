# Скопировать в .env рядом с docker-compose.yml и заполнить.
# ⚠️ В .env — секреты, он в .gitignore. Не коммитить.

# --- ОБЯЗАТЕЛЬНЫЕ ---

# Пароль PostgreSQL.  Сгенерировать:  openssl rand -hex 24
POSTGRES_PASSWORD=

# Секрет для подписи JWT (вход операторов).  Сгенерировать:  openssl rand -hex 32
KH_JWT_SECRET=

# --- ОПЦИОНАЛЬНЫЕ ---

# E-mail(ы) администраторов через запятую — кому дать роль admin.
KH_ADMIN_EMAILS=

# Прокси для Lemana ПРО (lemanapro.ru за Qrator блокирует IP сервера).
# SOCKS5 — авторизацию делает встроенный релей gost (см. backend/start.sh).
# Без этой строки сайт работает, но поиск цен Lemana — нет.
LEMANA_UPSTREAM_PROXY=

# Альтернатива — HTTP-прокси без авторизации (обычно не нужно):
# LEMANA_PROXY=
